<main class="contenedor">
    <form action="/vacantes/nueva" method="POST" class="default-form">
        <h3>General Information</h3>

        <div class="campo">
            <label>title</label>
            <input type="text" name="titulo" placeholder="Ej: React Developer" required>
        </div>
        <div class="campo">
            <label>Company</label>
            <input type="text" name="empresa" placeholder="Company Hires" required>
        </div>
        <div class="campo">
            <label>Location</label>
            <input type="text" name="ubicacion" placeholder="Ej: México o Remoto" required>
        </div>
        <div class="campo">
            <label>Salary (USD)</label>
            <input type="text" name="salario" placeholder="Ej: 500 USD" required>
        </div>
        <div class="campo">
            <label>Contract</label>
            <select name="contrato">
                <option value="" disabled selected>-- Select --</option>
                <option value="Freelance">Freelance</option>
                <option value="Tiempo Completo">Full Time</option>
                <option value="Medio Tiempo">Part Time</option>
                <option value="Por Proyecto">Project Based</option>
            </select>
        </div>
        <h3>Job Description</h3>
        <div class="campo descripcion">
            <label>Description</label>
            <input type="hidden" id="x" name="descripcion">
            <trix-editor input="x"></trix-editor>
        </div>

        <h3>Skills</h3>

        <ul class="lista-conocimientos">
            {{#seleccionarSkills}}
            {{/seleccionarSkills}}
        </ul>

        <div class="campo centrar-horizontal">
            <input type="hidden" name="skills" id="skills">
            <input type="submit" value="Publish" class="btn btn-azul">
        </div>


    </form>
</main>