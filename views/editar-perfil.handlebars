<main class="contenedor">
    <form action="/editar-perfil" method="POST" class="default-form" enctype="multipart/form-data">
        <div class="campo">
            <label>Name</label>
            <input type="text" name="nombre" value="{{usuario.nombre}}" placeholder="Your Name">
        </div>
        <div class="campo">
            <label>E-mail</label>
            <input type="email" name="email" value="{{usuario.email}}" placeholder="Your E-mail">
        </div>
        <div class="campo">
            <label>Password</label>
            <input type="password" name="password" placeholder="Your Password">
        </div>
        <div class="campo">
            <label>Image</label>
            <input type="file" name="imagen" placeholder="Your profile image">
            {{#if usuario.imagen}}
                <img src="/uploads/perfiles/{{usuario.imagen}}" class="admin-perfil" alt="Profile image">
            {{/if}}
        </div>
        <div class="campo">
            <input type="submit" class="btn btn-azul" value="Save Changes">
        </div>
    </form>
</main>
