<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link
      href="https://fonts.googleapis.com/css?family=Rubik:400,700,900"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/trix.css" />
    <link rel="stylesheet" href="/css/app.css" />
    {{#if trix}}
    {{/if}}
    <title>{{nombrePagina}}</title>
  </head>
  <body>

    <div class="nombre-sitio contenedor">
      <h1>
        <a href="/">devJobs</a>
      </h1>

      {{#if barra}}
        <div class="buscador">
          <form action="/buscador" method="POST">
            <input type="text" name="q" class="buscar" />
            <input type="submit" value="Buscar" />
          </form>
        </div>
      {{/if}}

      {{#if usuario}}
            <div class="cerrar-sesion">
                <p>Hi!, {{usuario.nombre}}</p>
                {{#if usuario.imagen}}
                    <img src="/uploads/perfiles/{{usuario.imagen}}" class="admin-perfil" alt="Profile">
                {{/if}}
                <a href="/administracion">Administration</a>
                <a href="/cerrar-sesion">Logout</a>
            </div>
      {{else}}
            <div class="cerrar-sesion">
                <a href="/iniciar-sesion">Sign in</a>
                <a href="/crear-cuenta">Create account</a>
            </div>
      {{/if}}

    </div>

    <header class="site-header contenedor separador">
      <h2>{{nombrePagina}}</h2>
      {{#if tagline}}
        <p class="tagline">{{tagline}}</p>
      {{/if}}

      {{#if boton}}
        <a href="/vacantes/nueva" class="btn btn-azul">Publish new vacancy</a>
      {{/if}}
    </header>

    <div class="contenido-principal contenedor">

      {{#if mensajes}}
      <div class="alertas">
        {{#mostrarAlertas mensajes}}{{/mostrarAlertas}}
      </div>
      {{/if}}

      {{{body}}}
    </div>

    
    {{#if trix}}
    <script src="/js/trix.js"></script>
    {{/if}}
    <script src="/dist/bundle.js"></script>
  </body>
</html>