<main class="contenedor">
    <form action="/crear-cuenta" method="POST" class="default-form">
        <div class="campo">
            <label>Name</label>
            <input type="text" name="nombre" placeholder="Your Name">
        </div>
        <div class="campo">
            <label>E-mail</label>
            <input type="email" name="email" placeholder="Your Email">
        </div>
        <div class="campo">
            <label>Password</label>
            <input type="password" name="password" placeholder="Your Password">
        </div>
        <div class="campo">
            <label>Rep Password</label>
            <input type="password" name="confirmar" placeholder="Repeat Password">
        </div>
        <div class="campo acciones">
            <a href="/iniciar-sesion">Back to Login</a>
        </div>

        <div class="campo">
            <input type="submit" value="Create Account" class="btn btn-azul">
        </div>
    </form>
</main>