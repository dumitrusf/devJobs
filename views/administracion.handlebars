<main class="lista-vacantes">
    <h2>Navigation</h2>
    <div class="botones separador">
        <a href="/editar-perfil" class="btn btn-azul">Edit Profile</a>
        <a href="/vacantes/nueva" class="btn btn-verde">New Vacancy</a>
    </div>

    <h2>Your Vacancies</h2>

    <div class="panel-administracion">
        {{#if vacantes.length}}
            {{#each vacantes}}
                <div class="vacante ">
                    <div class="caja">
                        <h3>{{empresa}}</h3>
                        <p class="puesto">{{titulo}}</p>
                        <p class="candidatos">
                            {{candidatos.length}} Candidate(s)
                        </p>
                        
                    </div>
                    <div class="centrar-vertical caja">
                        <a href="/candidatos/{{_id}}" class="btn btn-amarillo">Candidates</a>
                    </div>
                    <div class="centrar-vertical caja">
                        <a href="/vacantes/editar/{{url}}" class="btn btn-verde">Edit</a>
                    </div>
                    <div class="centrar-vertical caja">
                        <a href="#" data-eliminar="{{_id}}" class="btn btn-rojo">Delete</a>
                    </div>
                    <div class="centrar-vertical caja">
                        <a href="/vacantes/{{url}}" target="_blank" class="btn btn-verde">View</a>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p>No Vacancies, create one</p>
        {{/if}}
    </div>
</main>